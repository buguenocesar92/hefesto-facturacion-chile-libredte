# =============================================================================
# LibreDTE Slim — kit de despliegue Hefesto Studio
# PLANTILLA DE PRODUCCIÓN. Copiala a `.env` y completala.
#
#     cp .env.example .env
#
# Este archivo es SOLO tuyo: el stack NUNCA lo modifica.
# `.env` contiene secretos: nunca lo subas a git ni lo copies a un ticket.
# =============================================================================

# -----------------------------------------------------------------------------
# CÓMO GENERAR LOS SECRETOS (en el servidor, con openssl)
# -----------------------------------------------------------------------------
# Contraseña de PostgreSQL (se usa al crear la base la primera vez):
#     openssl rand -base64 32
#
# SECRET_KEY (firma sesiones y cookies; si cambia, se cae la sesión abierta):
#     python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# FIELD_ENCRYPTION_KEY (cifra la clave privada de los certificados digitales).
# La genera sola `setup` en el volumen `state` la primera vez. Si la ponés acá,
# que sea la MISMA que quedó registrada; cambiarla después rompe los
# certificados guardados a propósito. Formato: clave Fernet.
#     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Recordá: `FIELD_ENCRYPTION_KEY` sin su equivalente en los respaldos = los
# certificados guardados quedan ilegibles para siempre.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# OBLIGATORIAS — el compose se niega a arrancar sin estas tres
# -----------------------------------------------------------------------------

# Dominio del sitio tal como se escribe en el navegador (puerto incluido solo si
# no es 80/443). Slim RECHAZA con 400 cualquier otra cabecera Host.
# OBLIGATORIA
SITE_HOSTNAME=facturacion.ejemplo.cl

# Qué atiende Caddy. El dominio de arriba hace que Caddy obtenga y renueva solo
# un certificado de Let's Encrypt (necesita 80 y 443 alcanzables y el DNS
# apuntando al servidor). Con `:80` queda en HTTP plano, para ir detrás de otro
# proxy (Coolify/Traefik/nginx): ver docs/02-INSTALACION-COOLIFY.md.
# OBLIGATORIA
SITE_ADDRESS=facturacion.ejemplo.cl

# Contraseña de la base de datos. Generala con `openssl rand -base64 32`.
# OBLIGATORIA
# IMPORTANTE: cambiar esto acá DESPUÉS del primer arranque NO cambia la
# contraseña ya creada dentro de PostgreSQL. Hay que cambiarla también adentro.
DB_PASSWORD=PEGALE_AQUI_UN_BASE64_ALEATORIO_DE_32_BYTES

# -----------------------------------------------------------------------------
# TLS, puertos y esquema
# -----------------------------------------------------------------------------
# https cuando hay TLS (Caddy propio o un proxy delante).
SITE_URL_SCHEMA=https
# Otros hosts aceptados por Slim, separados por espacio y sin puerto.
# OJO: cada host extra es una puerta más al sistema.
#SITE_EXTRA_HOSTS=

# Con Coolify o Traefik delante, Caddy no debe publicar puertos del host:
# dejá HTTP_BIND/HTTP_PORT vacíos y activá overrides/traefik.yaml.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Tope de una subida (planillas de emisión masiva, certificados, logos).
UPLOAD_MAX_SIZE=32M

# -----------------------------------------------------------------------------
# Datos de demostración — PROHIBIDO en un servidor
# -----------------------------------------------------------------------------
# 0 en producción. Con 1 se crea el usuario `demo` / `Slim123%`, con
# contribuyente, certificado y CAF ficticios: es una puerta abierta con
# contraseña pública. Para pasar de demo a producción hay que partir de
# volúmenes nuevos (`docker compose down -v`).
SLIM_SEED_DEMO=0

# -----------------------------------------------------------------------------
# Secretos de la aplicación
# -----------------------------------------------------------------------------
# Si los dejás vacíos, `setup` los genera la primera vez y los guarda en el
# volumen `state` (que sí entra en los respaldos). Fijalos acá solo si querés
# gestionarlos tú; en ese caso, cambialos NUNCA a la ligera.
#SECRET_KEY=
#FIELD_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Correo (SMTP) — avisos de emisión masiva y recuperación de contraseña
# -----------------------------------------------------------------------------
# Sin EMAIL_HOST los correos se imprimen en el log en vez de enviarse.
#EMAIL_HOST=smtp.ejemplo.cl
#EMAIL_PORT=465
#EMAIL_USE_SSL=1
#EMAIL_USE_TLS=0
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
# Sin definir, se usa EMAIL_HOST_USER como remitente.
#DEFAULT_FROM_EMAIL=facturacion@ejemplo.cl

# -----------------------------------------------------------------------------
# Servicios externos de LibreDTE (opcionales)
# -----------------------------------------------------------------------------
# Cuenta de https://www.apigateway.cl para consultas al SII (catálogos,CAF).
# Sin token esas consultas no están disponibles.
#PLUGIN_APIGATEWAYCL_API_URL=https://app.apigateway.cl
#PLUGIN_APIGATEWAYCL_API_TOKEN=

# La Core API del stack no pide token. Solo si apuntás a otra que lo exija.
#PLUGIN_LIBREDTE_BACKEND_API_TOKEN=

# -----------------------------------------------------------------------------
# Versiones — fijadas, nunca `latest` salvo el backend que no publica tags
# -----------------------------------------------------------------------------
# v0.1.0b1 es una BETA (no existe una versión estable publicada: el repositorio
# LibreDTE/libredte-app-slim solo tiene ese tag). Ver VERSION.md y README.md.
SLIM_VERSION=v0.1.0b1
# Repositorio del código, solo se usa para construir (SLIM_VERSION vacío o tag
# no publicado).
#SLIM_REPO=https://github.com/LibreDTE/libredte-app-slim.git

# LibreDTE Lib Core API no publica versiones numeradas: `latest` es la última.
# Para fijarla de verdad, poné acá el hash COMPLETO (40 hexadecimales) del
# commit; el pie de Slim muestra esa versión exacta del backend.
CORE_API_VERSION=latest
#LIBREDTE_BACKEND_COMMIT=

POSTGRES_VERSION=18
VALKEY_VERSION=9.2
CADDY_VERSION=2.11
MAILPIT_VERSION=v1.31

# -----------------------------------------------------------------------------
# Perfiles y overrides
# -----------------------------------------------------------------------------
# Perfiles separados por coma: backup, hefesto, tools, mailpit.
# `hefesto` activa los respaldos con manifiesto y SHA-256 de Hefesto Studio.
COMPOSE_PROFILES=hefesto

# Capa de producción Hefesto (respaldos con manifiesto + paradas limpias).
COMPOSE_FILE=compose.yaml:compose.hefesto.yaml
# Datos en directorios del host en vez de volúmenes nombrados (recomendado:
# un `down -v` no los borra). Activalo ANTES del primer arranque.
#COMPOSE_FILE=compose.yaml:compose.hefesto.yaml:overrides/local-dirs.yaml
#DATA_DIR=./data

# Si hay un Traefik/Coolify delante: publica sin puertos del host.
#COMPOSE_FILE=compose.yaml:compose.hefesto.yaml:overrides/traefik.yaml
#TRAEFIK_HOST=facturacion.ejemplo.cl
#TRAEFIK_NETWORK=shared_network

# Frecuencia y retención de los respaldos Hefesto.
BACKUP_INTERVAL_HOURS=24
# 30 días, no los 7 de upstream: entre respaldo y respaldo hay un día entero.
BACKUP_KEEP_DAYS=30

# -----------------------------------------------------------------------------
# Ajustes de la aplicación y de los procesos
# -----------------------------------------------------------------------------
TZ=America/Santiago
LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# gunicorn (web) y Celery.
WEB_WORKERS=3
WEB_THREADS=4
WORKER_CONCURRENCY=3
# El worker de emisión masiva procesa de a una tarea por proceso: subir esto
# multiplica los certificados/timbres simultáneos.
WORKER_EMISION_MASIVA_CONCURRENCY=2

# Límites de memoria por servicio (suman el tope real del VPS).
DB_MEMORY_LIMIT=1g
VALKEY_MEMORY_LIMIT=256m
CORE_API_MEMORY_LIMIT=768m
SETUP_MEMORY_LIMIT=1g
WEB_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=1g
WORKER_EMISION_MASIVA_MEMORY_LIMIT=1g
CADDY_MEMORY_LIMIT=256m
CONSOLE_MEMORY_LIMIT=1g
BACKUP_MEMORY_LIMIT=512m
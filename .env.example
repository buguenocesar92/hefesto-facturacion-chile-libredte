# Plantilla: copiar a .env y completar. El .env nunca se versiona.

# Mantiene los nombres de volúmenes de instalaciones anteriores (libredte-slim_*).
COMPOSE_PROJECT_NAME=libredte-slim

# Uso directo (sin Coolify): publica los puertos de Caddy en el host.
# En Coolify no se declara COMPOSE_FILE.
COMPOSE_FILE=compose.yaml:overrides/puertos.yaml
COMPOSE_PROFILES=hefesto

# Obligatorias.
SITE_HOSTNAME=
SITE_ADDRESS=
DB_PASSWORD=

# Nunca 1 en un servidor (crea el usuario demo con contraseña pública).
SLIM_SEED_DEMO=0
